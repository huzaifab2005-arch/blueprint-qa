# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/blueprintqa

# Supabase: use a POOLER host, not the direct one. Supabase's direct host
# (db.<ref>.supabase.co) resolves to IPv6 only, and Render/Fly have no IPv6
# egress, so it fails with a connection timeout on every request.
#
#   session pooler (recommended)
#   DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@<cluster>-<region>.pooler.supabase.com:5432/postgres
#
#   transaction pooler (prepared statements are disabled automatically)
#   DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@<cluster>-<region>.pooler.supabase.com:6543/postgres
#
# Copy the exact string from Supabase: Project Settings -> Database -> Connection string.

# LLM provider: NVIDIA NIM (OpenAI-compatible API).
# Get a key at https://build.nvidia.com/ - it looks like nvapi-...
NVIDIA_API_KEY=nvapi-your-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Must be vision-capable; drawing pages are sent as images.
LLM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
LLM_MAX_TOKENS=2048

# Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_PAGES_PER_DOCUMENT=10
STORAGE_BACKEND=local   # "local" or "azure"

# Azure Blob Storage (only needed if STORAGE_BACKEND=azure)
AZURE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=blueprintqa

# Drawing assistant (all optional; defaults shown)
# LLM_TEXT_MODEL=            # text-only synthesis step; empty = use LLM_VISION_MODEL
# ASSISTANT_MAX_INDEX_PAGES=150
# ASSISTANT_TOP_K=5          # candidate pages sent to the vision model per question
# ASSISTANT_MODEL_IMAGE_PX=1600
# ASSISTANT_PAGE_IMAGE_PX=3600
